<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox spacing="0" prefWidth="480" prefHeight="700"
    style="-fx-background-color: #f0f4f8;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10"
        style="-fx-background-color: white;
                 -fx-padding: 16 24;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 0 0 1 0;">
        <Button text="←"
            style="-fx-background-color: transparent;
                       -fx-text-fill: #3b9eff;
                       -fx-font-size: 18px;
                       -fx-cursor: hand;
                       -fx-border-color: transparent;" />
        <Label text="CHUYỂN TIỀN"
            style="-fx-font-size: 15px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1e293b;"
            HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- BALANCE CARD -->
    <VBox alignment="CENTER" spacing="4"
        style="-fx-background-color: #1e3a5f;
                 -fx-padding: 24 32;">
        <Label text="SỐ DƯ HIỆN TẠI"
            style="-fx-font-size: 11px;
                      -fx-text-fill: rgba(255,255,255,0.6);
                      -fx-font-weight: bold;" />
        <Label text="5,000,000 VNĐ"
            style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;" />
        <Label text="TK: ACC0000001"
            style="-fx-font-size: 12px;
                      -fx-text-fill: rgba(255,255,255,0.5);" />
    </VBox>

    <!-- FORM -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
        style="-fx-background: #f0f4f8;
                       -fx-background-color: #f0f4f8;">
        <VBox spacing="16"
            style="-fx-background-color: white;
                     -fx-padding: 28 32;">

            <!-- TK đích -->
            <VBox spacing="6">
                <Label text="SỐ TÀI KHOẢN NHẬN"
                    style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #475569;" />
                <HBox alignment="CENTER_LEFT" spacing="0"
                    style="-fx-background-color: #f8fafc;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 0 12;">
                    <Label text="🏦"
                        style="-fx-font-size: 14px;
                                  -fx-padding: 0 10 0 0;" />
                    <TextField promptText="Nhập số tài khoản nhận"
                        prefHeight="44"
                        style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-font-size: 13px;"
                        HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- Số tiền -->
            <VBox spacing="6">
                <Label text="SỐ TIỀN (VNĐ)"
                    style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #475569;" />
                <HBox alignment="CENTER_LEFT" spacing="0"
                    style="-fx-background-color: #f8fafc;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 0 12;">
                    <Label text="💰"
                        style="-fx-font-size: 14px;
                                  -fx-padding: 0 10 0 0;" />
                    <TextField promptText="Nhập số tiền cần chuyển"
                        prefHeight="44"
                        style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-font-size: 13px;"
                        HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- Số tiền nhanh -->
            <VBox spacing="6">
                <Label text="CHỌN NHANH"
                    style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #475569;" />
                <HBox spacing="8">
                    <Button text="100K" prefWidth="100"
                        style="-fx-background-color: #f0f9ff;
                                   -fx-text-fill: #3b9eff;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #bae6fd;
                                   -fx-border-radius: 8;
                                   -fx-cursor: hand;" />
                    <Button text="500K" prefWidth="100"
                        style="-fx-background-color: #f0f9ff;
                                   -fx-text-fill: #3b9eff;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #bae6fd;
                                   -fx-border-radius: 8;
                                   -fx-cursor: hand;" />
                    <Button text="1 triệu" prefWidth="100"
                        style="-fx-background-color: #f0f9ff;
                                   -fx-text-fill: #3b9eff;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #bae6fd;
                                   -fx-border-radius: 8;
                                   -fx-cursor: hand;" />
                    <Button text="5 triệu" prefWidth="100"
                        style="-fx-background-color: #f0f9ff;
                                   -fx-text-fill: #3b9eff;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #bae6fd;
                                   -fx-border-radius: 8;
                                   -fx-cursor: hand;" />
                </HBox>
            </VBox>

            <!-- Mã PIN -->
            <VBox spacing="6">
                <Label text="MÃ PIN XÁC NHẬN"
                    style="-fx-font-size: 11px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #475569;" />
                <HBox alignment="CENTER_LEFT" spacing="0"
                    style="-fx-background-color: #f8fafc;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8;
                             -fx-background-radius: 8;
                             -fx-padding: 0 12;">
                    <Label text="🔑"
                        style="-fx-font-size: 14px;
                                  -fx-padding: 0 10 0 0;" />
                    <PasswordField promptText="Nhập mã PIN"
                        prefHeight="44"
                        style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-font-size: 13px;"
                        HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- Nút chuyển tiền -->
            <Button text="XÁC NHẬN CHUYỂN TIỀN"
                prefWidth="Infinity"
                prefHeight="50"
                style="-fx-background-color: #3b9eff;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;" />

            <!-- Nút hủy -->
            <Button text="Hủy"
                prefWidth="Infinity"
                prefHeight="44"
                style="-fx-background-color: transparent;
                           -fx-text-fill: #64748b;
                           -fx-font-size: 13px;
                           -fx-border-color: #e2e8f0;
                           -fx-border-radius: 10;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;" />
        </VBox>
    </ScrollPane>

</VBox>