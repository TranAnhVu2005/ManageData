<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<ScrollPane fitToWidth="true"
    style="-fx-background: #f0f4f8;
                   -fx-background-color: #f0f4f8;"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.bankmanagement.view.controller.LoginController">

    <VBox spacing="0"
        style="-fx-background-color: #f0f4f8;"
        prefWidth="480">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="10"
            style="-fx-background-color: white;
                     -fx-padding: 16 24 16 24;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 0 0 1 0;">
            <Label text="🏦" style="-fx-font-size: 24px;" />
            <Label text="BANK MANAGEMENT"
                style="-fx-font-size: 15px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;" />
        </HBox>


        <!-- FORM -->
        <VBox spacing="20"
            style="-fx-background-color: white;
                     -fx-padding: 36 32 36 32;">

            <!-- Tiêu đề -->
            <VBox spacing="6" alignment="CENTER">
                <Label text="BANK MANAGEMENT"
                    style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1e293b;" />
                <Label text="Hệ thống quản lý tài khoản ngân hàng"
                    style="-fx-font-size: 13px;
                              -fx-text-fill: #64748b;" />
            </VBox>

            <VBox spacing="16">

                <!-- Số tài khoản -->
                <VBox spacing="6">
                    <Label text="SỐ TÀI KHOẢN"
                        style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #475569;" />
                    <HBox alignment="CENTER_LEFT" spacing="0"
                        style="-fx-background-color: #f8fafc;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-padding: 0 16 0 16;">
                        <Label text="👤"
                            style="-fx-font-size: 14px;
                                      -fx-text-fill: #94a3b8;
                                      -fx-padding: 0 10 0 0;" />
                        <TextField fx:id="accountField"
                            promptText="Nhập số tài khoản"
                            prefHeight="48"
                            style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-font-size: 14px;
                                          -fx-text-fill: #1e293b;
                                          -fx-prompt-text-fill: #cbd5e1;"
                            HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <!-- Mật khẩu -->
                <VBox spacing="6">
                    <Label text="MẬT KHẨU"
                        style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #475569;" />
                    <HBox alignment="CENTER_LEFT" spacing="0"
                        style="-fx-background-color: #f8fafc;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-padding: 0 16 0 16;">
                        <Label text="🔒"
                            style="-fx-font-size: 14px;
                                      -fx-text-fill: #94a3b8;
                                      -fx-padding: 0 10 0 0;" />
                        <PasswordField fx:id="passwordField"
                            promptText="Nhập mật khẩu"
                            prefHeight="48"
                            style="-fx-background-color: transparent;
                                              -fx-border-color: transparent;
                                              -fx-font-size: 14px;
                                              -fx-text-fill: #1e293b;
                                              -fx-prompt-text-fill: #cbd5e1;"
                            HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <!-- Thông báo lỗi -->
                <Label fx:id="errorLabel"
                    text=""
                    visible="false"
                    style="-fx-text-fill: #ef4444;
                              -fx-font-size: 12px;
                              -fx-padding: 8 12;
                              -fx-background-color: #fef2f2;
                              -fx-background-radius: 6;
                              -fx-border-color: #fecaca;
                              -fx-border-radius: 6;"
                    maxWidth="Infinity" />

                <!-- Nút ĐĂNG NHẬP -->
                <Button fx:id="loginBtn"
                    text="ĐĂNG NHẬP  →"
                    onAction="#handleLogin"
                    prefWidth="Infinity"
                    prefHeight="50"
                    style="-fx-background-color: #3b9eff;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 15px;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;" />

                <!-- HOẶC -->
                <HBox alignment="CENTER" spacing="12">
                    <Separator HBox.hgrow="ALWAYS" />
                    <Label text="HOẶC"
                        style="-fx-font-size: 11px;
                                  -fx-text-fill: #94a3b8;" />
                    <Separator HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Nút ADMIN -->
                <Button fx:id="adminBtn"
                    text="🛡  ĐĂNG NHẬP ADMIN"
                    onAction="#handleAdminLogin"
                    prefWidth="Infinity"
                    prefHeight="46"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: #3b9eff;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-border-color: transparent;
                               -fx-cursor: hand;" />
            </VBox>
        </VBox>

        <!-- QUÊN MẬT KHẨU -->
        <HBox alignment="CENTER" spacing="4"
            style="-fx-background-color: white;
                     -fx-padding: 0 0 28 0;">
            <Label text="Quên mật khẩu?"
                style="-fx-font-size: 13px;
                          -fx-text-fill: #64748b;" />
            <Label text="Liên hệ hỗ trợ"
                style="-fx-font-size: 13px;
                          -fx-text-fill: #3b9eff;
                          -fx-font-weight: bold;
                          -fx-cursor: hand;" />
        </HBox>

        <!-- FOOTER -->
        <HBox alignment="CENTER"
            style="-fx-background-color: #f8fafc;
                     -fx-padding: 16 0 16 0;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 1 0 0 0;">
            <Label text="© 2024 Bank Management System. All rights reserved."
                style="-fx-font-size: 11px;
                          -fx-text-fill: #94a3b8;" />
        </HBox>

    </VBox>
</ScrollPane>