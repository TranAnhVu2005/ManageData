<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox spacing="0" prefWidth="700" prefHeight="700"
    style="-fx-background-color: #f0f4f8;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10"
        style="-fx-background-color: white;
                 -fx-padding: 16 24;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 0 0 1 0;">
        <Button text="←"
            style="-fx-background-color: transparent;
                       -fx-text-fill: #3b9eff;
                       -fx-font-size: 18px;
                       -fx-cursor: hand;
                       -fx-border-color: transparent;" />
        <Label text="LỊCH SỬ GIAO DỊCH"
            style="-fx-font-size: 15px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1e293b;"
            HBox.hgrow="ALWAYS" />
        <Button text="🔄  Tải lại"
            style="-fx-background-color: #f0f9ff;
                       -fx-text-fill: #3b9eff;
                       -fx-font-size: 12px;
                       -fx-background-radius: 6;
                       -fx-border-color: #bae6fd;
                       -fx-border-radius: 6;
                       -fx-cursor: hand;" />
    </HBox>

    <!-- THỐNG KÊ NHANH -->
    <HBox spacing="0"
        style="-fx-background-color: white;
                 -fx-padding: 16 24;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 0 0 1 0;">

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="TỔNG GIAO DỊCH"
                style="-fx-font-size: 10px;
                          -fx-text-fill: #94a3b8;
                          -fx-font-weight: bold;" />
            <Label text="3"
                style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;" />
        </VBox>

        <Separator orientation="VERTICAL"
            style="-fx-background-color: #e2e8f0;" />

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="TIỀN ĐÃ CHUYỂN"
                style="-fx-font-size: 10px;
                          -fx-text-fill: #94a3b8;
                          -fx-font-weight: bold;" />
            <Label text="1,500,000 VNĐ"
                style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #ef4444;" />
        </VBox>

        <Separator orientation="VERTICAL"
            style="-fx-background-color: #e2e8f0;" />

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="TIỀN ĐÃ NHẬN"
                style="-fx-font-size: 10px;
                          -fx-text-fill: #94a3b8;
                          -fx-font-weight: bold;" />
            <Label text="200,000 VNĐ"
                style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #16a34a;" />
        </VBox>

    </HBox>

    <!-- BẢNG GIAO DỊCH -->
    <TableView VBox.vgrow="ALWAYS"
        style="-fx-background-color: white;">
        <columns>
            <TableColumn text="Mã GD" prefWidth="160" />
            <TableColumn text="Loại" prefWidth="100" />
            <TableColumn text="Số tiền" prefWidth="130" />
            <TableColumn text="Tài khoản đích" prefWidth="120" />
            <TableColumn text="Thời gian" prefWidth="140" />
            <TableColumn text="Trạng thái" prefWidth="100" />
        </columns>
        <placeholder>
            <Label text="Không có giao dịch nào"
                style="-fx-text-fill: #94a3b8;
                          -fx-font-size: 13px;" />
        </placeholder>
    </TableView>

    <!-- FOOTER INFO -->
    <HBox alignment="CENTER_RIGHT"
        style="-fx-background-color: white;
                 -fx-padding: 12 24;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 1 0 0 0;">
        <Label text="Tổng: 3 giao dịch"
            style="-fx-font-size: 12px;
                      -fx-text-fill: #64748b;" />
    </HBox>

</VBox>